{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "CloudFormationProjectStacks", "Effect": "Allow", "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:*:${ACCOUNT_ID}:stack/${PROJECT}*/*" },
    { "Sid": "CloudFormationReadOnly", "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:ListStacks", "cloudformation:DescribeStacks", "cloudformation:GetTemplateSummary"],
      "Resource": "*" },
    { "Sid": "ProjectBuckets", "Effect": "Allow", "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${PROJECT}-*", "arn:aws:s3:::${PROJECT}-*/*"] },
    { "Sid": "ProjectEcr", "Effect": "Allow", "Action": "ecr:*",
      "Resource": "arn:aws:ecr:*:${ACCOUNT_ID}:repository/${PROJECT}-*" },
    { "Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    { "Sid": "ProjectLambda", "Effect": "Allow", "Action": "lambda:*",
      "Resource": ["arn:aws:lambda:*:${ACCOUNT_ID}:function:${PROJECT}-*", "arn:aws:lambda:*:${ACCOUNT_ID}:function:${PROJECT}-*:*"] },
    { "Sid": "LambdaRead", "Effect": "Allow", "Action": ["lambda:GetAccountSettings", "lambda:ListFunctions"], "Resource": "*" },
    { "Sid": "ProjectDynamoDb", "Effect": "Allow", "Action": "dynamodb:*",
      "Resource": ["arn:aws:dynamodb:*:${ACCOUNT_ID}:table/${PROJECT}-*", "arn:aws:dynamodb:*:${ACCOUNT_ID}:table/${PROJECT}-*/*"] },
    { "Sid": "DynamoDbDescribe", "Effect": "Allow", "Action": ["dynamodb:DescribeLimits", "dynamodb:ListTables"], "Resource": "*" },
    { "Sid": "ProjectEcs", "Effect": "Allow", "Action": "ecs:*",
      "Resource": ["arn:aws:ecs:*:${ACCOUNT_ID}:cluster/${PROJECT}*", "arn:aws:ecs:*:${ACCOUNT_ID}:task-definition/${PROJECT}-*:*", "arn:aws:ecs:*:${ACCOUNT_ID}:task/${PROJECT}*/*"] },
    { "Sid": "EcsUnscopedApis", "Effect": "Allow",
      "Action": ["ecs:CreateCluster", "ecs:RegisterTaskDefinition", "ecs:DeregisterTaskDefinition", "ecs:DescribeTaskDefinition", "ecs:ListTaskDefinitions", "ecs:ListClusters", "ecs:ListTasks"],
      "Resource": "*" },
    { "Sid": "ProjectRoles", "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:UpdateRole", "iam:TagRole", "iam:UntagRole", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:DeleteRolePolicy", "iam:ListRolePolicies", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies", "iam:UpdateAssumeRolePolicy", "iam:PassRole"],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/${PROJECT}-*" },
    { "Sid": "DenyEditingThisDeployerRole", "Effect": "Deny", "Action": "iam:*",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/${PROJECT}-deployer" },
    { "Sid": "EcsServiceLinkedRole", "Effect": "Allow", "Action": "iam:CreateServiceLinkedRole", "Resource": "*",
      "Condition": { "StringEquals": { "iam:AWSServiceName": ["ecs.amazonaws.com"] } } },
    { "Sid": "Networking", "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute", "ec2:CreateSubnet", "ec2:DeleteSubnet", "ec2:ModifySubnetAttribute", "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway", "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute", "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress", "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress", "ec2:CreateVpcEndpoint", "ec2:DeleteVpcEndpoints", "ec2:ModifyVpcEndpoint", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "*" },
    { "Sid": "CloudFront", "Effect": "Allow", "Action": "cloudfront:*", "Resource": "*" },
    { "Sid": "ProjectLogs", "Effect": "Allow", "Action": "logs:*",
      "Resource": ["arn:aws:logs:*:${ACCOUNT_ID}:log-group:/${PROJECT}/*", "arn:aws:logs:*:${ACCOUNT_ID}:log-group:/${PROJECT}/*:*", "arn:aws:logs:*:${ACCOUNT_ID}:log-group:/aws/lambda/${PROJECT}-*", "arn:aws:logs:*:${ACCOUNT_ID}:log-group:/aws/lambda/${PROJECT}-*:*"] },
    { "Sid": "LogsDescribe", "Effect": "Allow", "Action": "logs:DescribeLogGroups", "Resource": "*" },
    { "Sid": "ProjectSchedule", "Effect": "Allow", "Action": "events:*",
      "Resource": "arn:aws:events:*:${ACCOUNT_ID}:rule/${PROJECT}-*" },
    { "Sid": "ProjectParameters", "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter", "ssm:GetParameters", "ssm:DeleteParameter", "ssm:AddTagsToResource", "ssm:ListTagsForResource"],
      "Resource": "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/${PROJECT}/*" },
    { "Sid": "ParameterDescribe", "Effect": "Allow", "Action": "ssm:DescribeParameters", "Resource": "*" },
    { "Sid": "Budgets", "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:ModifyBudget", "budgets:ListTagsForResource", "budgets:TagResource", "budgets:UntagResource"],
      "Resource": "arn:aws:budgets::${ACCOUNT_ID}:budget/${PROJECT}-*" },
    { "Sid": "Identity", "Effect": "Allow", "Action": "sts:GetCallerIdentity", "Resource": "*" },
    { "Sid": "Certificates", "Effect": "Allow",
      "Action": ["acm:RequestCertificate", "acm:DescribeCertificate", "acm:DeleteCertificate", "acm:ListCertificates", "acm:AddTagsToCertificate", "acm:ListTagsForCertificate", "acm:GetCertificate"],
      "Resource": "*" },
    { "Sid": "DnsRead", "Effect": "Allow",
      "Action": ["route53:GetHostedZone", "route53:ListHostedZones", "route53:ListHostedZonesByName", "route53:ListResourceRecordSets", "route53:GetChange"],
      "Resource": "*" },
    { "Sid": "DnsWriteOnlyProjectRecords", "Effect": "Allow", "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*",
      "Condition": { "ForAllValues:StringLike": { "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["${DOMAIN_NAME}", "_*.${DOMAIN_NAME}"] } } }
  ]
}
